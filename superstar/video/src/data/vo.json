{"source": "audio/src/vo/vo_signal_a.mp3", "lines": [{"id": "L01", "text": "This market doesn't trend.", "start": 1.0, "end": 2.39, "words": [[1.0, 1.22, "This"], [1.22, 1.54, "market"], [1.54, 1.98, "doesn't"], [1.98, 2.34, "trend,"]]}, {"id": "L02", "text": "It whipsaws.", "start": 3.0, "end": 3.79, "words": [[3.0, 3.2, "it"], [3.2, 3.74, "whipsaws,"]]}, {"id": "L03", "text": "Ninety-one direction changes in a month.", "start": 4.6, "end": 6.55, "words": [[4.6, 5.18, "91"], [5.18, 5.56, "direction"], [5.56, 6.06, "changes"], [6.06, 6.28, "in"], [6.28, 6.4, "a"], [6.4, 6.55, "month,"]]}, {"id": "L04", "text": "Five hundred and forty-two million dollars of longs, liquidated.", "start": 8.3, "end": 11.74, "words": [[8.4, 9.52, "542"], [9.52, 9.78, "million"], [9.78, 10.14, "dollars"], [10.14, 10.36, "of"], [10.36, 10.98, "longs"], [10.98, 11.72, "liquidated,"]]}, {"id": "L05", "text": "Six hundred and sixteen million of shorts.", "start": 12.2, "end": 14.26, "words": [[12.22, 13.32, "616"], [13.32, 13.58, "million"], [13.58, 13.86, "of"], [13.86, 14.18, "shorts."]]}, {"id": "L06", "text": "Pick one side, and this market makes you pay.", "start": 15.8, "end": 18.41, "words": [[15.8, 16.04, "Pick"], [16.04, 16.32, "one"], [16.32, 16.65, "side"], [16.65, 16.65, "and"], [17.24, 17.38, "this"], [17.38, 17.66, "market"], [17.66, 17.94, "makes"], [17.94, 18.14, "you"], [18.14, 18.38, "pay,"]]}, {"id": "L07", "text": "Unless you can trade both.", "start": 18.8, "end": 20.2, "words": [[18.8, 19.12, "unless"], [19.12, 19.4, "you"], [19.4, 19.6, "can"], [19.6, 19.86, "trade"], [19.86, 20.2, "both."]]}, {"id": "L08", "text": "Meet Superstar.", "start": 22.35, "end": 23.24, "words": [[22.35, 22.75, "Meet"], [22.75, 23.24, "Superstar,"]]}, {"id": "L09", "text": "An intelligent agent, trading both sides for you.", "start": 23.55, "end": 26.0, "words": [[23.55, 23.69, "an"], [23.69, 24.15, "intelligent"], [24.15, 24.57, "agent"], [24.57, 25.07, "trading"], [25.07, 25.37, "both"], [25.37, 25.63, "sides"], [25.63, 25.89, "for"], [25.89, 26.0, "you."]]}, {"id": "L10", "text": "Every four hours, it takes a fresh read of the market, and makes one decision.", "start": 27.0, "end": 31.72, "words": [[27.0, 27.3, "Every"], [27.3, 27.5, "four"], [27.5, 27.78, "hours,"], [28.22, 28.32, "it"], [28.32, 28.57, "takes"], [28.57, 28.67, "a"], [28.67, 28.97, "fresh"], [28.97, 29.22, "read"], [29.22, 29.32, "of"], [29.32, 29.42, "the"], [29.42, 29.82, "market,"], [30.62, 30.82, "and"], [30.82, 31.07, "makes"], [31.07, 31.27, "one"], [31.27, 31.72, "decision."]]}, {"id": "L11", "text": "It reads the last four hours, hour by hour.", "start": 34.4, "end": 37.48, "words": [[34.4, 34.52, "It"], [34.52, 34.92, "reads"], [34.92, 35.36, "the"], [35.36, 35.64, "last"], [35.64, 35.94, "four"], [35.94, 36.29, "hours,"], [36.79, 37.03, "hour"], [37.03, 37.21, "by"], [37.21, 37.48, "hour,"]]}, {"id": "L12", "text": "Weighs eighteen market signals: leverage, liquidations, order flow, whales against retail.", "start": 42.2, "end": 48.2, "words": [[42.2, 42.58, "weighs"], [42.58, 43.08, "18"], [43.08, 43.46, "market"], [43.46, 43.92, "signals,"], [44.4, 44.7, "leverage,"], [45.24, 45.9, "liquidations,"], [46.3, 46.56, "order"], [46.56, 46.86, "flow,"], [47.36, 47.54, "wails"], [47.54, 47.9, "against"], [47.9, 48.2, "retail,"]]}, {"id": "L13", "text": "Argues the bull case, and the bear case, each with the exact level that proves it wrong.", "start": 50.2, "end": 55.06, "words": [[50.21, 50.45, "argues"], [50.45, 50.65, "the"], [50.65, 50.83, "bull"], [50.83, 51.05, "case"], [51.05, 51.49, "and"], [51.49, 51.59, "the"], [51.59, 51.79, "bear"], [51.79, 52.03, "case,"], [52.9, 53.18, "each"], [53.18, 53.42, "with"], [53.42, 53.56, "the"], [53.56, 53.9, "exact"], [53.9, 54.24, "level"], [54.24, 54.52, "that"], [54.52, 54.76, "proves"], [54.76, 54.96, "it"], [54.96, 55.06, "wrong."]]}, {"id": "L14", "text": "Then it chooses. Long. Short. Or nothing at all.", "start": 55.4, "end": 59.69, "words": [[55.4, 55.75, "Then"], [55.75, 56.1, "it"], [56.1, 56.65, "chooses."], [57.19, 57.52, "Long."], [58.18, 58.51, "Short."], [59.07, 59.22, "Or"], [59.22, 59.52, "nothing"], [59.52, 59.62, "at"], [59.62, 59.69, "all."]]}, {"id": "L15", "text": "In the backtest, it sat out 1,350 of 2,298 reviews.", "start": 60.2, "end": 66.97, "words": [[60.2, 60.88, "In"], [60.88, 61.02, "the"], [61.02, 61.5, "backtest,"], [62.0, 62.05, "it"], [62.02, 62.24, "set"], [62.24, 62.42, "out"], [62.42, 63.96, "1350."], [64.76, 65.44, "Of"], [65.44, 66.12, "2298"], [66.12, 66.86, "reviews,"]]}, {"id": "L16", "text": "Risk comes first. The loss limit is set before entry, and never widened.", "start": 67.2, "end": 72.29, "words": [[67.29, 67.47, "risk"], [67.47, 67.91, "comes"], [67.91, 68.27, "first,"], [68.9, 69.04, "the"], [69.04, 69.22, "loss"], [69.22, 69.48, "limit"], [69.48, 69.74, "is"], [69.74, 69.94, "set"], [69.94, 70.32, "before"], [70.32, 70.68, "entry"], [70.68, 70.71, "and"], [71.43, 71.71, "never"], [71.71, 72.15, "widened."]]}, {"id": "L17", "text": "Size follows the limit. The stop only moves to protect.", "start": 72.6, "end": 76.44, "words": [[72.8, 72.86, "Size"], [72.86, 73.22, "follows"], [73.22, 73.46, "the"], [73.46, 73.74, "limit,"], [74.51, 74.77, "the"], [74.77, 75.03, "stop"], [75.03, 75.67, "only"], [75.67, 75.91, "moves"], [75.91, 76.17, "to"], [76.17, 76.44, "protect."]]}, {"id": "L18", "text": "Backtested as Bitcoin rose to one hundred and twenty-four thousand, and fell to sixty-three,", "start": 76.8, "end": 81.32, "words": [[76.87, 77.25, "Backtested"], [77.25, 77.55, "as"], [77.55, 77.85, "Bitcoin"], [77.85, 78.13, "rose"], [78.13, 78.39, "to"], [78.39, 79.17, "124"], [79.17, 79.85, ",000"], [79.85, 80.35, "and"], [80.35, 80.49, "fell"], [80.49, 80.67, "to"], [80.67, 81.03, "63."]]}, {"id": "L19", "text": "it finished positive through both halves.", "start": 81.6, "end": 83.34, "words": [[81.6, 81.88, "It"], [81.88, 82.12, "finished"], [82.12, 82.6, "positive"], [82.6, 82.86, "through"], [82.86, 83.1, "both"], [83.1, 83.34, "halves."]]}, {"id": "L20", "text": "Spot, perps, and HIP-3, on Hyperliquid.", "start": 84.2, "end": 87.83, "words": [[84.2, 84.55, "Spot,"], [85.13, 85.38, "perps"], [85.38, 85.38, "and"], [86.01, 86.53, "hip3"], [86.53, 86.62, "on"], [87.15, 87.77, "Hyperliquid."]]}, {"id": "L21", "text": "USDC in. USDC out.", "start": 88.0, "end": 90.55, "words": [[88.04, 88.46, "USDC"], [88.46, 88.84, "in,"], [89.53, 90.15, "USDC"], [90.15, 90.55, "out,"]]}, {"id": "L22", "text": "Superstar. Now live on Deploy.", "start": 91.0, "end": 93.41, "words": [[91.07, 91.61, "Superstar."], [92.07, 92.17, "Now,"], [92.65, 92.71, "live"], [92.71, 92.95, "on"], [92.95, 93.27, "deploy."]]}]}